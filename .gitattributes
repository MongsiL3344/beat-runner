# 텍스트는 저장소에 LF로 저장
* text=auto

# Unity YAML 에셋은 텍스트로 비교
*.unity text
*.prefab text
*.asset text
*.meta text
*.asmdef text
*.inputactions text

# 바이너리
*.png binary
*.jpg binary
*.psd binary
*.ttf binary
*.otf binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary
*.bundle binary
*.zip binary
*.pdf binary
